<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Baskara.MainPage"
             Title="Bhaskara">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" HorizontalOptions="Center">
        <Image Source="bhaskara_icon.png" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,10"/>

            <Label Text="Calculadora de Bhaskara" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>

            <Label Text="Digite os coeficientes da equação ax^2 + bx + c = 0"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <Entry x:Name="inputA"
                   Placeholder="A"
                  
                   Keyboard="Numeric"/>

            <Entry x:Name="inputB"
                   Placeholder="B"
                   Keyboard="Numeric"/>

            <Entry x:Name="inputC"
                   Placeholder="C"
                   Keyboard="Numeric"/>
            
            <Button Text="Calcular Raizes"
                    Clicked="Button_Clicked"
                    Margin="0,8,0,0"/>
            
            <Label x:Name="ResultadoLabel"
                   FontSize="18"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap"
                   Margin="0,12,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
